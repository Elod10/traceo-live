<?xml version="1.0" encoding="utf-8"?>
<!-- Logo Tracéo Live : le tracé de Tracéo relie deux stations, celle d'arrivée émet le direct.
     Dessiné dans le repère 512 du logo, ramené dans la zone sûre de l'icône adaptative (Ø 66), avec une marge.
     Aucun aplat de fond : les trous laissent voir l'arrière-plan, ce qui permet de réutiliser ce
     dessin tel quel comme icône monochrome (icônes à thème d'Android 13). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="286"
        android:pivotY="240"
        android:scaleX="0.124"
        android:scaleY="0.124"
        android:translateX="-232"
        android:translateY="-186">
        <!-- Tracé, coupé sous les deux stations -->
        <path
            android:pathData="M150,380 C150,266 340,276 340,172"
            android:strokeColor="#7FB2E5"
            android:strokeWidth="34"
            android:strokeLineCap="butt"
            android:trimPathStart="0.1352"
            android:trimPathEnd="0.8643" />
        <!-- Station de départ -->
        <path
            android:pathData="M110,380 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0"
            android:strokeColor="#1C1A24"
            android:strokeWidth="22" />
        <!-- Ondes du direct -->
        <path
            android:pathData="M378,98 A88,88 0 0,1 414,212"
            android:strokeColor="#E2001A"
            android:strokeWidth="20"
            android:strokeLineCap="round" />
        <path
            android:pathData="M396,56 A130,130 0 0,1 452,228"
            android:strokeAlpha="0.45"
            android:strokeColor="#E2001A"
            android:strokeWidth="20"
            android:strokeLineCap="round" />
        <!-- Station d'arrivée -->
        <path
            android:fillType="evenOdd"
            android:fillColor="#E2001A"
            android:pathData="M284,172 a56,56 0 1,0 112,0 a56,56 0 1,0 -112,0 Z M321,172 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 Z" />
    </group>
</vector>
