<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/back"
            style="@style/IconAction"
            android:layout_marginStart="9dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <TextView
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_sources_title" />

            <TextView
                android:id="@+id/not_affiliated"
                style="@style/Text.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sources_not_affiliated"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/about"
                style="@style/Text.Legal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColorLink="@color/text_primary" />

            <TextView
                android:id="@+id/index_date"
                style="@style/Text.Legal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <!-- Une entrée par réseau utilisé hors Île-de-France, d'après le catalogue de Tracéo. -->
            <TextView
                android:id="@+id/networks_about"
                style="@style/Text.Legal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColorLink="@color/text_primary"
                android:visibility="gone" />

            <TextView
                style="@style/Text.Legal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/sources_font" />

            <TextView
                android:id="@+id/code_licence"
                style="@style/Text.Legal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/sources_code_licence"
                android:textColorLink="@color/text_primary" />

            <TextView
                android:id="@+id/version"
                style="@style/Text.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
